# Budgeteer Development Environment Variables
# Copy this file to .env and fill in your values

# Monzo OAuth Credentials
# Get these from https://developers.monzo.com/
MONZO_CLIENT_ID=oauth2client_xxxxx
MONZO_CLIENT_SECRET=your-client-secret-here

# Redirect URI - must match what's configured in Monzo Developer Portal
# For local development with ngrok:
MONZO_REDIRECT_URI=https://your-ngrok-url.ngrok-free.dev/auth/callback
