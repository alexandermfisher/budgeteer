# Budgeteer Development Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# MONZO OAUTH
# =============================================================================
# Get these from https://developers.monzo.com/
MONZO_CLIENT_ID=oauth2client_xxxxx
MONZO_CLIENT_SECRET=your-client-secret-here

# Redirect URI - must match what's configured in Monzo Developer Portal
# For local development with ngrok:
MONZO_REDIRECT_URI=https://your-ngrok-url.ngrok-free.dev/auth/callback

# =============================================================================
# APP AUTHENTICATION (JWE Tokens)
# =============================================================================
# REQUIRED: JWE secret key for session token encryption
# Generate with: openssl rand -base64 32
JWE_SECRET_KEY=your-32-byte-base64-encoded-key-here

# =============================================================================
# MONZO TOKEN ENCRYPTION
# =============================================================================
# REQUIRED: Encryption key for Monzo OAuth tokens stored in database
# Uses AES-256-GCM encryption - key must be exactly 32 bytes when decoded
# Generate with: openssl rand -base64 32
MONZO_ENCRYPTION_KEY=your-32-byte-base64-encoded-key-here

# App base URL (used in magic link emails)
APP_BASE_URL=http://localhost:8080

# Enable email sending (set to true in production)
APP_EMAIL_ENABLED=false

# =============================================================================
# EMAIL (Magic Links) - Resend SMTP
# =============================================================================
# When APP_EMAIL_ENABLED=false, magic links are logged to console
# For production, set APP_EMAIL_ENABLED=true and configure Resend:

# Resend SMTP settings (get API key from https://resend.com)
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=re_xxxxxxxxxxxx_your_resend_api_key_here

# From address (must be verified domain in Resend)
MAIL_FROM=noreply@domain

# =============================================================================
# GITHUB MCP SERVER (Claude Code integration)
# =============================================================================
# Fine-grained PAT — needs Contents/Issues/PRs/Metadata read on this repo
# Generate at: GitHub → Settings → Developer settings → Fine-grained tokens
GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_your_token_here

# =============================================================================
# DATABASE (REQUIRED — no defaults; app and compose both fail fast if unset)
# =============================================================================
# Generate a strong DB_PASSWORD with: openssl rand -base64 24
DB_HOST=localhost
DB_PORT=5432
DB_NAME=budgeteer
DB_USER=budgeteer
DB_PASSWORD=replace-me-with-a-strong-password
