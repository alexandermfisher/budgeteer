#!/usr/bin/env -S java --source 25
///usr/bin/env true; exec java --source 25 "$0" "$@"

import javax.crypto.Cipher;
import javax.crypto.SecretKey;
import javax.crypto.spec.GCMParameterSpec;
import javax.crypto.spec.SecretKeySpec;
import java.nio.ByteBuffer;
import java.nio.charset.StandardCharsets;
import java.util.Base64;

/**
 * Decrypts a Budgeteer AES-256-GCM encrypted token.
 *
 * Usage:
 *   ./scripts/decrypt-token <encrypted-token>
 *       Key read from MONZO_ENCRYPTION_KEY environment variable.
 *
 *   ./scripts/decrypt-token <base64-key> <encrypted-token>
 *       Key supplied explicitly.
 *
 * The encrypted format is: base64( 12-byte IV || ciphertext || 16-byte GCM tag )
 */
public class decrypt_token {

    public static void main(String[] args) throws Exception {
        String key;
        String token;

        if (args.length == 1) {
            key = System.getenv("MONZO_ENCRYPTION_KEY");
            if (key == null || key.isBlank()) {
                err("MONZO_ENCRYPTION_KEY is not set. Either export it or pass the key as the first argument.");
                err("Usage: ./scripts/decrypt-token [<base64-key>] <encrypted-token>");
                System.exit(1);
            }
            token = args[0];
        } else if (args.length == 2) {
            key = args[0];
            token = args[1];
        } else {
            err("Usage: ./scripts/decrypt-token [<base64-key>] <encrypted-token>");
            err("  Key defaults to MONZO_ENCRYPTION_KEY env var when not supplied.");
            System.exit(1);
            return;
        }

        byte[] keyBytes   = Base64.getDecoder().decode(key.strip());
        byte[] combined   = Base64.getDecoder().decode(token.strip());

        if (combined.length < 12 + 16) {
            err("Ciphertext too short — does not match expected format (IV || ciphertext || tag).");
            System.exit(1);
        }

        ByteBuffer buf = ByteBuffer.wrap(combined);
        byte[] iv = new byte[12];
        buf.get(iv);
        byte[] ciphertextWithTag = new byte[buf.remaining()];
        buf.get(ciphertextWithTag);

        SecretKey secretKey = new SecretKeySpec(keyBytes, "AES");
        Cipher cipher = Cipher.getInstance("AES/GCM/NoPadding");
        cipher.init(Cipher.DECRYPT_MODE, secretKey, new GCMParameterSpec(128, iv));
        byte[] plaintext = cipher.doFinal(ciphertextWithTag);

        System.out.println(new String(plaintext, StandardCharsets.UTF_8));
    }

    private static void err(String msg) {
        System.err.println(msg);
    }
}
