									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData.data.status).to.equal(\"UP\");",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"console.log(\"✅ App is healthy!\");",
