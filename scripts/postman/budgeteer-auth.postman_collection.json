		{
			"name": "Dev Tools",
			"item": [
				{
					"name": "⚡ Quick Login (Dev Only)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Returns tokens\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData.data).to.have.property(\"accessToken\");",
									"    pm.expect(jsonData.data).to.have.property(\"refreshToken\");",
									"});",
									"",
									"// Auto-save tokens to environment",
									"var jsonData = pm.response.json();",
									"pm.environment.set(\"access_token\", jsonData.data.accessToken);",
									"pm.environment.set(\"refresh_token\", jsonData.data.refreshToken);",
									"pm.environment.set(\"user_id\", jsonData.data.userId);",
									"pm.environment.set(\"user_email\", jsonData.data.email);",
									"",
									"console.log(\"✅ Logged in as: \" + jsonData.data.email);",
									"console.log(\"🔑 Access token saved to environment\");",
									"console.log(\"🆔 User ID: \" + jsonData.data.userId);",
									"console.log(\"\");",
									"console.log(\"Auth methods available:\");",
									"console.log(\"  - Cookie-based (automatic in browser)\");",
									"console.log(\"  - Bearer token: Authorization: Bearer {{access_token}}\");"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{user_email}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/dev/auth/quick-login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"dev",
								"auth",
								"quick-login"
							]
						},
						"description": "⚡ **DEV ONLY** - Quick login without magic link flow!\n\nThis endpoint:\n- Creates user if doesn't exist\n- Auto-verifies email\n- Returns tokens in response body\n- Sets HttpOnly cookies\n\n**Tokens are auto-saved to environment variables!**\n\n⚠️ This endpoint only exists in dev profile."
					},
					"response": []
				},
				{
					"name": "☢️ Revoke ALL Sessions (Dev Only)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Sessions revoked\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData.data).to.have.property(\"sessionsRevoked\");",
									"});",
									"",
									"// Clear local tokens",
									"pm.environment.unset(\"access_token\");",
									"pm.environment.unset(\"refresh_token\");",
									"",
									"var jsonData = pm.response.json();",
									"console.log(\"☢️ Nuclear option executed!\");",
									"console.log(\"Sessions revoked: \" + jsonData.data.sessionsRevoked);",
									"console.log(jsonData.data.message);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/dev/auth/revoke-all",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"dev",
								"auth",
								"revoke-all"
							]
						},
						"description": "☢️ **DEV ONLY** - Nuclear option! Revokes ALL sessions for ALL users.\n\nUse this when you want to:\n- Clear all cached/stale cookies\n- Force everyone to re-login\n- Reset test state\n\n⚠️ This endpoint only exists in dev profile."
					},
					"response": []
				},
				{
					"name": "🔒 Revoke User Sessions (Dev Only)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Sessions revoked\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData.data).to.have.property(\"sessionsRevoked\");",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"console.log(\"🔒 User sessions revoked!\");",
									"console.log(\"Sessions revoked: \" + jsonData.data.sessionsRevoked);",
									"console.log(jsonData.data.message);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/dev/auth/revoke-user?email={{user_email}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"dev",
								"auth",
								"revoke-user"
							],
							"query": [
								{
									"key": "email",
									"value": "{{user_email}}"
								}
							]
						},
						"description": "🔒 **DEV ONLY** - Revoke all sessions for a specific user.\n\nUseful when testing:\n- Logout from all devices\n- Session invalidation\n- Token rotation\n\n⚠️ This endpoint only exists in dev profile."
					},
					"response": []
				}
			],
			"description": "Development-only endpoints for easier testing.\n\n⚠️ These only work when the server is running with `dev` profile!"
		},
		{
			"name": "Auth Flow (Cookies)",
			"item": [
				{
					"name": "1. Login (Request Magic Link)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response indicates success\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData.data.message).to.include(\"Check your email\");",
									"});",
									"",
									"// Save email to environment",
									"var requestBody = JSON.parse(pm.request.body.raw);",
									"pm.environment.set(\"user_email\", requestBody.email);",
									"",
									"console.log(\"📧 Magic link sent! Check server console for the token.\");",
									"console.log(\"Copy the token and set it in the 'magic_link_token' environment variable.\");"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{user_email}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Request a magic link to be sent to the user's email.\n\nIn dev mode, the link is printed to the server console."
					},
					"response": []
				},
				{
					"name": "2. Verify Magic Link",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Login successful\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData.data.message).to.equal(\"Login successful\");",
									"});",
									"",
									"// Save tokens to environment",
									"var jsonData = pm.response.json();",
									"if (jsonData.data.accessToken) {",
									"    pm.environment.set(\"access_token\", jsonData.data.accessToken);",
									"    pm.environment.set(\"refresh_token\", jsonData.data.refreshToken);",
									"    console.log(\"🔑 Tokens saved to environment\");",
									"}",
									"",
									"// Cookies are also set by server",
									"console.log(\"✅ Logged in!\");",
									"console.log(\"🍪 Cookies have been set\");",
									"console.log(\"You can now use authenticated endpoints.\");"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"if (!pm.environment.get(\"magic_link_token\")) {",
									"    console.warn(\"⚠️ magic_link_token is not set!\");",
									"    console.log(\"Copy the token from server console and set it in environment variables.\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"description": "Request JSON response (vs redirect for browsers)"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/auth/verify?token={{magic_link_token}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"verify"
							],
							"query": [
								{
									"key": "token",
									"value": "{{magic_link_token}}"
								}
							]
						},
						"description": "Verify the magic link token and log in.\n\n**Content Negotiation:**\n- `Accept: application/json` → Returns JSON with tokens (this request)\n- `Accept: text/html` (browser) → 302 redirect to frontend\n\nThis sets HttpOnly cookies:\n- `access_token` (15 min expiry)\n- `refresh_token` (7 day expiry)\n\nTokens are also returned in the response body for API clients."
					},
					"response": []
				},
				{
					"name": "3. Get Current User (Cookie)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Returns user data\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData.data).to.have.property(\"id\");",
									"    pm.expect(jsonData.data).to.have.property(\"email\");",
									"    pm.expect(jsonData.data).to.have.property(\"emailVerified\");",
									"});",
									"",
									"// Save user ID for later use",
									"var jsonData = pm.response.json();",
									"pm.environment.set(\"user_id\", jsonData.data.id);",
									"",
									"console.log(\"👤 User: \" + jsonData.data.email);",
									"console.log(\"🆔 ID: \" + jsonData.data.id);",
									"console.log(\"🍪 Auth method: Cookies\");"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/auth/me",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"me"
							]
						},
						"description": "Get the currently authenticated user's details.\n\n**Uses cookie-based auth** - cookies are automatically sent by Postman."
					},
					"response": []
				},
				{
					"name": "4. Refresh Token (Cookie)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Token refreshed\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData.data.message).to.equal(\"Token refreshed\");",
									"});",
									"",
									"// Tokens are returned in body, save them",
									"var jsonData = pm.response.json();",
									"if (jsonData.data.accessToken) {",
									"    pm.environment.set(\"access_token\", jsonData.data.accessToken);",
									"    pm.environment.set(\"refresh_token\", jsonData.data.refreshToken);",
									"    console.log(\"🔑 New tokens saved to environment\");",
									"}",
									"",
									"console.log(\"🔄 Tokens refreshed!\");",
									"console.log(\"🍪 New cookies have been set\");"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/auth/refresh",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"refresh"
							]
						},
						"description": "Refresh the access token using the refresh token cookie.\n\n**Uses cookie-based auth** - refresh token cookie is automatically sent.\n\nThis rotates both tokens:\n- Old refresh token is revoked\n- New access and refresh tokens are set in cookies\n- Tokens also returned in response body"
					},
					"response": []
				},
				{
					"name": "5. Logout",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Logged out\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData.data.message).to.equal(\"Logged out\");",
									"});",
									"",
									"// Clear environment variables",
									"pm.environment.unset(\"magic_link_token\");",
									"pm.environment.unset(\"access_token\");",
									"pm.environment.unset(\"refresh_token\");",
									"",
									"console.log(\"🚪 Logged out! Refresh token has been revoked.\");",
									"console.log(\"Note: Access token may still work briefly until it expires.\");"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/auth/logout",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"logout"
							]
						},
						"description": "Log out the current user.\n\nThis:\n- Revokes the refresh token in the database\n- Clears the cookies"
					},
					"response": []
				}
			],
			"description": "Complete authentication flow using cookies (browser-style).\n\nCookies are automatically managed by Postman."
		},
		{
			"name": "Auth Flow (Bearer Token)",
			"item": [
				{
					"name": "Get Current User (Bearer)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Returns user data\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData.data).to.have.property(\"id\");",
									"    pm.expect(jsonData.data).to.have.property(\"email\");",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"console.log(\"👤 User: \" + jsonData.data.email);",
									"console.log(\"🆔 ID: \" + jsonData.data.id);",
									"console.log(\"🎫 Auth method: Bearer token\");"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"if (!pm.environment.get(\"access_token\")) {",
									"    console.warn(\"⚠️ access_token is not set!\");",
									"    console.log(\"Run 'Quick Login' first to get a token.\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{access_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/auth/me",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"me"
							]
						},
						"description": "Get the currently authenticated user's details.\n\n**Uses Bearer token auth** - token is sent in Authorization header.\n\nFormat: `Authorization: Bearer <access_token>`"
					},
					"response": []
				},
				{
					"name": "Refresh Token (Body)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Token refreshed\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData.data.message).to.equal(\"Token refreshed\");",
									"    pm.expect(jsonData.data).to.have.property(\"accessToken\");",
									"    pm.expect(jsonData.data).to.have.property(\"refreshToken\");",
									"});",
									"",
									"// Save new tokens to environment",
									"var jsonData = pm.response.json();",
									"pm.environment.set(\"access_token\", jsonData.data.accessToken);",
									"pm.environment.set(\"refresh_token\", jsonData.data.refreshToken);",
									"",
									"console.log(\"🔄 Tokens refreshed!\");",
									"console.log(\"🔑 New access_token saved to environment\");",
									"console.log(\"🔑 New refresh_token saved to environment\");"
